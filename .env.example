# ─── Local development: copy this file to .env ───

# Matches docker-compose.yml (PostgreSQL on port 5433).
DATABASE_URL="postgresql://piramid:piramid@localhost:5433/piramid"

# Session encryption key. Generate one with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google OAuth credentials (see README, "Google sign-in").
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email-only login for local testing. Ignored in production builds.
DEV_LOGIN="true"

# Where uploaded photos and receipts are stored.
UPLOAD_DIR="./uploads"

# ─── VPS: /var/www/apps/piramid/.env uses these instead (read by docker-compose.prod.yml) ───
# APP_PORT=3100
# POSTGRES_PASSWORD=     generated by the first deploy if missing
# AUTH_SECRET=           generated by the first deploy if missing
# AUTH_URL=https://your-domain
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
