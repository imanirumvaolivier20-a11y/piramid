generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity (global, not tenant-scoped) ─────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  memberships   Membership[]
  ownedAccounts Account[]
  workerLinks   Worker[]
  projects      Project[]
  contracts     Contract[]
  dailyReports  DailyReport[]
  expenses      Expense[]

  materialRequests   MaterialRequest[] @relation("RequestedBy")
  materialDecisions  MaterialRequest[] @relation("DecidedBy")
  materialReceipts   MaterialRequest[] @relation("ReceivedBy")
  attendanceRecorded Attendance[]
  workerPayments     WorkerPayment[]
}

/// Lookup table of account types. New types (supplier, architect, ...) are
/// rows here; features are driven by the capability flags, not by the key.
model AccountType {
  key              String  @id
  label            String
  description      String
  sortOrder        Int     @default(0)
  /// Offered on the onboarding screen.
  selectable       Boolean @default(true)
  canOwnProjects   Boolean @default(false)
  canBeHired       Boolean @default(false)
  canManageWorkers Boolean @default(false)

  accounts Account[]
}

/// The tenant. Companies and individuals are both Accounts, so everything
/// tenant-owned hangs off one accountId regardless of account type.
model Account {
  id         String   @id @default(cuid())
  typeKey    String
  name       String
  /// Public handle used for search and profile URLs.
  username   String   @unique
  email      String?
  phone      String?
  location   String?
  bio        String?
  currency   String   @default("RWF")
  /// Storage key of the uploaded logo. Without one, the owner's Google photo is shown.
  logoKey    String?  @unique
  /// How often workers are paid; payroll groups attendance by this period.
  payCycle   PayCycle @default(WEEKLY)
  /// Lets workers join a company account.
  inviteCode String?  @unique
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  type        AccountType      @relation(fields: [typeKey], references: [key])
  owner       User             @relation(fields: [ownerId], references: [id])
  memberships Membership[]
  projects    Project[]
  categories  WorkerCategory[]
  workers     Worker[]
  expenses    Expense[]
  reports     DailyReport[]

  contractsAsOwner      Contract[]        @relation("ContractOwner")
  contractsAsContractor Contract[]        @relation("ContractContractor")
  projectMembers        ProjectMember[]
  materialRequestsSent  MaterialRequest[] @relation("RequestFrom")
  materialRequestsTo    MaterialRequest[] @relation("RequestTo")
  attendance            Attendance[]
  workerPayments        WorkerPayment[]

  @@index([typeKey])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  accountId String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

// ───────────── Tenant-scoped (row-level security applies) ─────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  /// The owning tenant (the Project Owner's account).
  accountId   String
  name        String
  location    String?
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @db.Date
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id])
  contracts        Contract[]
  members          ProjectMember[]
  reports          DailyReport[]
  expenses         Expense[]
  materialRequests MaterialRequest[]
  attendance       Attendance[]

  @@index([accountId])
}

enum EngagementModel {
  /// Contractor manages everything for an agreed total budget.
  FULL_MANAGEMENT
  /// Contractor does the work; owner pays for materials and labor on request.
  OWNER_FUNDS
}

enum ContractStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

/// A hire: the project's owner account engages a company or engineer.
model Contract {
  id                  String          @id @default(cuid())
  projectId           String
  ownerAccountId      String
  contractorAccountId String
  engagementModel     EngagementModel
  status              ContractStatus  @default(PENDING)
  /// Total agreed budget under FULL_MANAGEMENT. Unused until budget logic is built.
  agreedBudget        Decimal?        @db.Decimal(14, 2)
  note                String?
  hiredById           String
  createdAt           DateTime        @default(now())
  respondedAt         DateTime?
  endedAt             DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      Account @relation("ContractOwner", fields: [ownerAccountId], references: [id])
  contractor Account @relation("ContractContractor", fields: [contractorAccountId], references: [id])
  hiredBy    User    @relation(fields: [hiredById], references: [id])

  @@index([projectId])
  @@index([contractorAccountId])
  @@index([ownerAccountId])
}

/// Worker categories are editable per account (Engineer, Builder, Aid, ...).
model WorkerCategory {
  id        String   @id @default(cuid())
  accountId String
  name      String
  /// Default daily wage; drives payroll accrual in a later phase.
  dailyRate Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workers Worker[]
  wages   DailyReportWage[]

  @@unique([accountId, name])
}

/// Roster entry. Optionally linked to a User so the worker can sign in.
model Worker {
  id         String   @id @default(cuid())
  accountId  String
  name       String
  categoryId String?
  phone      String?
  email      String?
  userId     String?
  /// Personal daily wage; overrides the category's rate when set.
  dailyRate  Decimal? @db.Decimal(14, 2)
  /// Removed workers with pay history are deactivated, never deleted.
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    WorkerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments ProjectMember[]
  attendance  Attendance[]
  payments    WorkerPayment[]

  @@index([accountId])
  @@index([userId])
}

enum ProjectRole {
  STORE_KEEPER
  FOREMAN
  ENGINEER
  BUILDER
  AID
}

/// A roster worker assigned to a project with a role.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  workerId  String
  /// The account whose roster the worker belongs to (owner or contractor).
  accountId String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, workerId])
  @@index([workerId])
}

/// The core activity-log entry: one report of a day's work on a project.
model DailyReport {
  id           String   @id @default(cuid())
  projectId    String
  /// The account the author was acting for (owner or contractor).
  accountId    String
  date         DateTime @db.Date
  description  String
  workersCount Int      @default(0)
  createdById  String
  createdAt    DateTime @default(now())

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account   Account               @relation(fields: [accountId], references: [id])
  createdBy User                  @relation(fields: [createdById], references: [id])
  photos    DailyReportPhoto[]
  materials DailyReportMaterial[]
  wages     DailyReportWage[]

  @@index([projectId, date])
}

model DailyReportPhoto {
  id          String   @id @default(cuid())
  reportId    String
  /// Storage key (see src/lib/storage.ts).
  key         String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportMaterial {
  id       String  @id @default(cuid())
  reportId String
  name     String
  quantity Decimal @db.Decimal(14, 3)
  unit     String

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Wages for the day, one row per worker category.
model DailyReportWage {
  id           String  @id @default(cuid())
  reportId     String
  categoryId   String?
  /// Snapshot, so the report stays readable if the category is renamed or removed.
  categoryName String
  workers      Int
  amount       Decimal @db.Decimal(14, 2)

  report   DailyReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category WorkerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

enum ExpenseCategory {
  MATERIALS
  SALARIES
  LABOR
  TRANSPORT
  EQUIPMENT
  PERMITS
  OTHER
}

model Expense {
  id                String          @id @default(cuid())
  projectId         String
  accountId         String
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime        @db.Date
  note              String?
  receiptKey        String?         @unique
  /// Set when the expense was recorded automatically on receiving a material request.
  materialRequestId String?         @unique
  createdById       String
  createdAt         DateTime        @default(now())

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  materialRequest MaterialRequest? @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
}

enum MaterialRequestStatus {
  /// Waiting for the recipient to approve or reject.
  SUBMITTED
  /// Approved; the materials are being bought or delivered.
  APPROVED
  REJECTED
  /// Delivered on site and counted.
  RECEIVED
  /// Withdrawn by the requester before a decision.
  CANCELLED
}

/// A request for materials, sent by someone on the project to the account
/// that pays: the project owner, or the hired company/engineer.
model MaterialRequest {
  id            String                @id @default(cuid())
  projectId     String
  /// Sequential per project, shown as #1, #2, ...
  number        Int
  /// The account the requester was acting for.
  fromAccountId String
  /// The account asked to approve and pay. Can change when a request is forwarded.
  toAccountId   String
  status        MaterialRequestStatus @default(SUBMITTED)
  note          String?
  neededBy      DateTime?             @db.Date
  requestedById String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  forwardedAt   DateTime?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  receivedById  String?
  receivedAt    DateTime?
  receivedNote  String?

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromAccount Account               @relation("RequestFrom", fields: [fromAccountId], references: [id])
  toAccount   Account               @relation("RequestTo", fields: [toAccountId], references: [id])
  requestedBy User                  @relation("RequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                 @relation("DecidedBy", fields: [decidedById], references: [id])
  receivedBy  User?                 @relation("ReceivedBy", fields: [receivedById], references: [id])
  items       MaterialRequestItem[]
  expense     Expense?

  @@unique([projectId, number])
  @@index([toAccountId, status])
}

model MaterialRequestItem {
  id               String   @id @default(cuid())
  requestId        String
  /// Short name used to total materials across requests and reports, e.g. "Cement".
  name             String
  /// Free-text product description: brand, size, grade, colour...
  details          String?
  quantity         Decimal  @db.Decimal(14, 3)
  unit             String
  /// Price per unit. Estimated by the requester, confirmed on approval.
  unitPrice        Decimal? @db.Decimal(14, 2)
  /// Counted on delivery; differences from `quantity` are discrepancies.
  receivedQuantity Decimal? @db.Decimal(14, 3)
  sortOrder        Int      @default(0)

  request MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum PayCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

/// One worker's attendance on one day. The wage is accrued from it, using the
/// daily rate in force when it was recorded.
model Attendance {
  id           String           @id @default(cuid())
  projectId    String
  workerId     String
  /// The worker's roster account, which owes the wage.
  accountId    String
  date         DateTime         @db.Date
  status       AttendanceStatus
  /// Daily rate snapshot, so later rate changes do not rewrite history.
  rate         Decimal          @db.Decimal(14, 2)
  /// Wage earned: the rate for a full day, half of it for a half day, 0 if absent.
  amount       Decimal          @db.Decimal(14, 2)
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  account    Account @relation(fields: [accountId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  /// A worker is paid once per day, whichever project they were on.
  @@unique([workerId, date])
  @@index([projectId, date])
  @@index([accountId, date])
}

/// Money paid to a worker. Balance owed = attendance earned - payments.
model WorkerPayment {
  id          String    @id @default(cuid())
  accountId   String
  workerId    String
  amount      Decimal   @db.Decimal(14, 2)
  date        DateTime  @db.Date
  /// The pay period this payment settles, when paid from payroll.
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())

  account   Account @relation(fields: [accountId], references: [id])
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([workerId, date])
  @@index([accountId, date])
}
